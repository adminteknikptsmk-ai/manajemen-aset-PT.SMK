      "fields": [
        { "name": "id", "type": "string" },
        { "name": "date", "type": "string" },
        { "name": "referenceNo", "type": "string" },
        { "name": "type", "type": "string" },
        { "name": "category", "type": "string" },
        { "name": "amount", "type": "number" },
        { "name": "description", "type": "string" },
        { "name": "relatedHospitalName", "type": "string" },
        { "name": "marketingName", "type": "string" },
        { "name": "auditStatus", "type": "string" },
        { "name": "auditorName", "type": "string" },
        { "name": "auditNotes", "type": "string" },
        { "name": "auditedAt", "type": "string" },
        { "name": "createdAt", "type": "timestamp" },
        { "name": "updatedAt", "type": "timestamp" }
      ],
      "rules": {
        "read": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",
        "create": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",
        "update": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
      }
    }
  ]
}
