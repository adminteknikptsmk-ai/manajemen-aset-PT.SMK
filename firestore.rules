rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        // Fallback for bootstrap
        request.auth.token.email == 'adminteknik.ptsmk@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Calibrator Assets ---
    match /calibratorAssets/{assetId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Tablet Assets ---
    match /tabletAssets/{assetId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Tablet Loans ---
    match /tabletLoans/{loanId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Hospitals ---
    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Technicians ---
    match /technicians/{technicianId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Marketing Staff ---
    match /marketingStaff/{marketingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Schedules ---
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- SPH Documents ---
    match /sphDocuments/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- SPK Documents ---
    match /spkDocuments/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Financial Assets ---
    match /financialAssets/{assetId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- Financial Transactions ---
    match /financialTransactions/{trxId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- Settings & Document Templates ---
    match /settings/branding {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
